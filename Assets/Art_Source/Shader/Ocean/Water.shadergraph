{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ff5f28675bbb4037972ae2559ad7d5ce",
    "m_Group": {
        "m_Id": "f8c5e1307da94c9692795a52121b6a68"
    },
    "m_Name": "GerstnerWaves (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1939.19970703125,
            "y": -634.39990234375,
            "width": 242.39990234375,
            "height": 189.59994506835938
        }
    },
    "m_Slots": [
        {
            "m_Id": "eeb3d5baa2524df89206e667f856e93d"
        },
        {
            "m_Id": "6faee6bd6da748ea9d199cd367b73d59"
        },
        {
            "m_Id": "90f5e1b60a274e2886c6eccd402db393"
        },
        {
            "m_Id": "3f3f9a8e55fa416e8ab15ea74c4b0887"
        },
        {
            "m_Id": "2e01fc16f9614d11b583a4de5baf0419"
        },
        {
            "m_Id": "7415d3fede3d4c4f936f8e3f496820bd"
        },
        {
            "m_Id": "75399733dedc425daf4806d3a77c47c2"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GerstnerWaves",
    "m_FunctionSource": "a42e42974cf8e4c4fbacf4b15a9d4415",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void GerstnerWaves_float(float3 WorldPos, float Time, float Amplitude, float Frequency, float Speed,\r\n    out float3 OffsetWS, out float3 NormalWS)\r\n{\r\n    float3 offset = float3(0, 0, 0);\r\n    float3 normal = float3(0, 1, 0);\r\n\r\n    float2 dirs[3] = { float2(1,0), float2(0.6,0.8), float2(-0.7,0.7) };\r\n    float steep[3]  = { 0.35, 0.25, 0.18 };\r\n    float wlen[3]   = { 1.0, 0.55, 0.32 };\r\n\r\n    [unroll]\r\n    for (int i = 0; i < 3; i++)\r\n    {\r\n        float k = 6.2831853 / (wlen[i] / Frequency);\r\n        float c = sqrt(9.8 / k) * Speed;\r\n        float2 d = normalize(dirs[i]);\r\n        float f = k * (dot(d, WorldPos.xz) - c * Time);\r\n        float a = Amplitude * steep[i] / k;\r\n\r\n        offset.x += d.x * a * cos(f);\r\n        offset.z += d.y * a * cos(f);\r\n        offset.y += a * sin(f);\r\n\r\n        normal.x -= d.x * steep[i] * sin(f);\r\n        normal.z -= d.y * steep[i] * sin(f);\r\n    }\r\n\r\n    OffsetWS= offset;\r\n    NormalWS= normalize(normal);\r\n}"
}

